   "reader": "table_rows",
   "args": {
    "table": "cmdb_model",
    "fields": [
     "name",
     "manufacturer",
     "model_number"
    ],
    "query": "manufacturerISNOTEMPTY^model_numberISNOTEMPTY"
   },
   "compare": {
    "name": "dq_duplicate_by",
    "args": {
     "fields": [
      "manufacturer",
      "model_number"
     ],
     "require": [
      "manufacturer",
      "model_number"
     ],
     "label": "name",
     "unit": "models with a manufacturer and part number"
    }
   },
   "partial": {
    "kind": "false_positive_risk",
    "not_covered": "The part number is the model number. Genuine variants sharing a part number are counted."
   }
  },
  "DQ-116": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "sc_cat_item",
     "fields": [
      "name",
      "active",
      "sys_class_name"
