      "ci",
      "assigned_to"
     ]
    },
    {
     "table": "cmdb_ci",
     "fields": [
      "assigned_to"
     ]
    }
   ],
   "reader": "table_rows",
   "args": {
    "table": "alm_asset",
    "fields": [
     "display_name",
     "ci",
     "assigned_to"
    ],
    "query": "ciISNOTEMPTY^assigned_toISNOTEMPTY"
   },
   "compare": {
    "name": "dq_asset_ci_assignee",
    "args": {}
   },
   "partial": {
    "kind": "false_positive_risk",
    "not_covered": "The custodian-versus-user guard is not applied: a deliberate difference is counted."
   }
  },
  "DQ-111": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "sys_user",
     "fields": [
      "user_name",
      "email",
      "employee_number",
      "active"
     ]
    }
   ],
   "reader": "table_rows",
   "args": {
    "table": "sys_user",
    "fields": [
     "user_name",
     "email",
     "employee_number",
     "active"
    ],
    "query": ""
   },
   "compare": {
    "name": "dq_duplicate_users",
    "args": {}
   },
   "partial": {
    "kind": "false_positive_risk",
    "not_covered": "Active-active pairs are charged; active-inactive pairs (supersession) are counted in the observation only. A deliberate second account (an admin account) sharing an email is counted."
   }
  },
  "DQ-112": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "sys_user_grmember",
     "fields": [
      "group",
      "user"
     ]
    },
    {
     "table": "sys_user_group",
     "fields": [
      "active"
     ]
    },
    {
     "table": "sys_user",
     "fields": [
      "active"
     ]
    }
   ],
   "reader": "table_rows",
   "args": {
    "table": "sys_user_grmember",
    "fields": [
     "group",
     "user"
    ],
    "query": "group.active=true^user.active=true"
   },
   "compare": {
    "name": "dq_duplicate_groups",
    "args": {
     "overlap": {
      "$param": "overlap"
     },
     "min_members": {
      "$param": "min_members"
     }
    }
   },
   "partial": {
    "kind": "false_positive_risk",
    "not_covered": "Overlap is the shared members over the union of the two active member sets (Jaccard). Groups with the same people serving different functions are counted."
   }
  },
  "DQ-113": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "cmn_location",
     "fields": [
      "name",
      "street",
      "city",
      "zip",
      "country"
     ]
    }
   ],
   "reader": "table_rows",
   "args": {
    "table": "cmn_location",
    "fields": [
     "name",
     "street",
     "city",
     "zip",
     "country"
    ],
    "query": "streetISNOTEMPTY"
   },
   "compare": {
    "name": "dq_duplicate_by",
    "args": {
     "fields": [
      "street",
      "city",
      "zip",
      "country"
     ],
     "require": [
      "street"
     ],
     "label": "name",
     "unit": "locations with a street address"
    }
   },
   "partial": {
    "kind": "false_positive_risk",
    "not_covered": "Addresses are compared after case, spacing and punctuation are normalised; floors or buildings recorded as separate locations at one address are counted."
   }
  },
  "DQ-114": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "core_company",
     "fields": [
      "name"
     ]
    }
   ],
   "reader": "table_rows",
   "args": {
    "table": "core_company",
    "fields": [
     "name"
    ],
    "query": "nameISNOTEMPTY"
   },
   "compare": {
    "name": "dq_duplicate_by",
    "args": {
     "fields": [
      "name"
     ],
     "require": [
      "name"
     ],
     "label": "name",
     "unit": "companies"
    }
   },
   "partial": {
    "kind": "detection_gap",
    "not_covered": "Names are compared after case, spacing and punctuation are normalised. core_company has no registration identifier on the platform (verified, Phase 7). Legally distinct entities with the same name are counted."
   }
  },
  "DQ-115": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "cmdb_model",
     "fields": [
      "name",
      "manufacturer",
      "model_number"
     ]
    }
