   "reader": "table_rows",
   "args": {
    "table": "sc_cat_item",
    "fields": [
     "name",
     "sys_class_name"
    ],
    "query": "active=true^sys_class_nameINsc_cat_item,pc_hardware_cat_item,pc_software_cat_item"
   },
   "compare": {
    "name": "dq_duplicate_by",
    "args": {
     "fields": [
      "name"
     ],
     "require": [
      "name"
     ],
     "label": "name",
     "unit": "active requestable items"
    }
   },
   "partial": {
    "kind": "detection_gap",
    "not_covered": "Matching normalised names are found; identical variable sets with the same fulfilment are not compared. Deliberate variants for different audiences are counted."
   }
  },
  "DQ-120": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "sys_user_group",
     "fields": [
