    "fields": [
     "name",
     "sys_created_on"
    ],
    "query": "active=true"
   },
   "compare": {
    "name": "dq_stale_membership",
    "args": {
     "max_age": {
      "$param": "max_age",
      "as": "window"
     }
    }
   },
   "partial": {
    "kind": "detection_gap",
    "not_covered": "A membership change is read as the newest membership record; a REMOVAL leaves no record, so a group changed only by removals is counted as unchanged. Genuinely stable teams are counted."
   }
  },
