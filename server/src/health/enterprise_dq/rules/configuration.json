{
 "engine": "configuration",
 "rules": {
  "DQ-085": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "cmn_location",
     "fields": [
      "name",
      "country",
      "time_zone"
     ]
    },
    {
     "table": "contract_sla",
     "fields": [
      "start_condition",
      "stop_condition",
      "active"
     ]
    },
    {
     "table": "sysrule_assignment",
     "fields": [
      "condition",
      "active"
     ]
    }
   ],
   "reader": "table_rows",
   "args": {
    "table": "cmn_location",
    "fields": [
     "name",
     "country",
     "time_zone"
    ],
    "query": ""
   },
   "compare": {
    "name": "dq_location_fields_referenced",
    "args": {}
   },
   "partial": {
    "kind": "detection_gap",
    "not_covered": "The rules that depend on the fields are the active SLA definitions and assignment rules whose conditions read location.country or location.time_zone (D-033); routing in flows is not read."
   }
  },
  "DQ-090": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "sys_user_group",
     "fields": [
      "name",
      "type",
      "active"
     ]
    }
   ],
   "reader": "table_rows",
   "args": {
    "table": "sys_user_group",
    "fields": [
     "name",
     "type",
     "active"
    ],
    "query": "active=true"
   },
   "compare": {
    "name": "dq_empty_where_used",
    "args": {
     "field": "type",
     "label": "name",
     "unit": "active groups",
     "practice": "group typing"
    }
   }
  },
  "DQ-097": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "sysevent_email_action",
     "fields": [
      "active",
      "recipient_users",
      "recipient_groups"
     ]
    },
    {
     "table": "sys_user",
     "fields": [
      "email",
      "active"
     ]
    },
    {
     "table": "sys_user_group",
     "fields": [
      "email",
      "active"
     ]
    }
   ],
   "reader": "table_rows",
   "args": {
    "table": "sysevent_email_action",
    "fields": [
     "recipient_users",
     "recipient_groups"
    ],
    "query": "active=true"
   },
   "compare": {
    "name": "dq_notification_email_format",
    "args": {}
   },
   "partial": {
    "kind": "detection_gap",
    "not_covered": "Users and groups named directly on active notifications are judged with a permissive validator; recipients reached through a record field are resolved per record and are not."
   }
  },
  "DQ-098": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "sys_properties",
     "fields": [
      "name"
     ]
    },
    {
     "table": "sys_dictionary",
     "fields": [
      "name",
      "element",
      "choice",
      "internal_type",
      "choice_table"
     ]
    },
    {
     "table": "sys_choice",
     "fields": [
      "name",
      "element",
      "value",
      "inactive"
     ]
    },
    {
     "table": "sys_db_object",
     "fields": [
      "name",
      "super_class"
     ]
    }
   ],
   "reader": "table_rows",
   "args": {
    "table": "sys_properties",
    "fields": [
     "name"
    ],
    "query": "name=glide.product.name"
   },
   "compare": {
    "name": "dq_choice_values_unlisted",
    "args": {
     "tables": [
      "sys_user",
      "sys_user_group",
      "core_company",
      "cmn_location",
      "cmn_department",
      "alm_asset",
      "cmdb_ci",
      "cmdb_ci_hardware",
      "cmdb_model",
      "kb_knowledge",
      "sc_cat_item",
      "sc_req_item",
      "task",
      "contract_sla",
      "sysapproval_approver"
     ]
    }
   },
   "partial": {
    "kind": "detection_gap",
    "not_covered": "The dropdown choice fields (choice 1 or 3) of the master and reference tables Enterprise Data Quality judges (D-037); values in use on active records, per record class, against the class's own list or the nearest table it extends that has one; workflow stages and choices drawn from another table are not sys_choice lists and are left out. Inactive choices still in use are their own case (the workbook). Other tables are not read: 29,518 choice fields exist on the validation instance."
   }
  },
  "DQ-099": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "alm_asset",
     "fields": [
      "install_status",
      "substatus",
      "ci"
     ]
    },
    {
     "table": "alm_asset_ci_state_mapping",
     "fields": [
      "asset_state",
      "configuration_item_status"
     ]
    },
    {
     "table": "alm_hardware_state_mapping",
     "fields": [
      "asset_state",
      "hardware_ci_status"
     ]
    },
    {
     "table": "cmdb_ci",
     "fields": [
      "install_status"
     ]
    },
    {
     "table": "cmdb_ci_hardware",
     "fields": [
      "hardware_status"
     ]
    }
   ],
   "reader": "table_rows",
   "args": {
    "table": "alm_asset",
    "fields": [
     "display_name",
     "install_status",
     "substatus",
     "ci",
     "sys_class_name"
    ],
    "query": "ciISNOTEMPTY"
   },
   "compare": {
    "name": "dq_asset_ci_state_contradiction",
    "args": {}
   },
   "partial": {
    "kind": "detection_gap",
    "not_covered": "The mapping is the platform's own (Asset CI Install Status Mapping; hardware state mapping for hardware, D-033), read from the asset side: rows that map asset → CI or both ways."
   }
  },
  "DQ-102": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "cmdb_ci",
     "fields": [
      "name",
      "sys_class_name",
      "model_id"
     ]
    },
    {
     "table": "cmdb_model",
     "fields": [
      "name",
      "cmdb_ci_class"
     ]
    }
   ],
   "reader": "table_rows",
   "args": {
    "table": "cmdb_ci",
    "fields": [
     "name",
     "sys_class_name",
     "model_id"
    ],
    "query": "model_idISNOTEMPTY"
   },
   "compare": {
    "name": "dq_model_class_contradiction",
    "args": {}
   },
   "partial": {
    "kind": "detection_gap",
    "not_covered": "The mapping is the model's own CI class (cmdb_model.cmdb_ci_class, D-033); a CI in that class or a subclass agrees."
   }
  },
  "DQ-103": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "sys_user",
     "fields": [
      "user_name",
      "manager"
     ]
    }
   ],
   "reader": "table_rows",
   "args": {
    "table": "sys_user",
    "fields": [
     "user_name",
     "manager"
    ],
    "query": "managerISNOTEMPTY"
   },
   "compare": {
    "name": "dq_reference_cycles",
    "args": {
     "field": "manager",
     "label": "user_name",
     "unit": "users with a manager",
     "selfLoops": false
    }
   },
   "partial": {
    "kind": "evidence_gap",
    "not_covered": "The whole manager graph is walked (each user once), so no depth bound is needed. A user who is their own manager is DQ-100, not a loop here."
   }
  },
  "DQ-104": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "cmn_location",
     "fields": [
      "name",
      "parent"
     ]
    }
   ],
   "reader": "table_rows",
   "args": {
    "table": "cmn_location",
    "fields": [
     "name",
     "parent"
    ],
    "query": "parentISNOTEMPTY"
   },
   "compare": {
    "name": "dq_reference_cycles",
    "args": {
     "field": "parent",
     "label": "name",
     "unit": "locations with a parent",
     "selfLoops": true
    }
   },
   "partial": {
    "kind": "evidence_gap",
    "not_covered": "The whole location tree is walked (each location once), so no depth bound is needed; a location that is its own parent is reported as a loop of one."
   }
  },
  "DQ-105": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "sys_user",
     "fields": [
      "active",
      "company",
      "department"
     ]
    },
    {
     "table": "cmn_department",
     "fields": [
      "company"
     ]
    }
   ],
   "reader": "table_rows",
   "args": {
    "table": "sys_user",
    "fields": [
     "user_name",
     "company",
     "department"
    ],
    "query": "active=true^companyISNOTEMPTY^departmentISNOTEMPTY"
   },
   "compare": {
    "name": "dq_department_company",
    "args": {}
   },
   "partial": {
    "kind": "false_positive_risk",
    "not_covered": "\"Multi-company\" is read as active users in more than one company. Cross-entity secondments are counted."
   }
  },
  "DQ-107": {
   "engine": "configuration",
   "requires_tables": [
    {
     "table": "alm_asset",
