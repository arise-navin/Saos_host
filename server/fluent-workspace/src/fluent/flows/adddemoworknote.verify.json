{
  "kind": "subflow",
  "subflow": "AddDemoWorkNote",
  "setup": {
    "table": "incident",
    "payload": {
      "short_description": "Test incident for AddDemoWorkNote subflow"
    }
  },
  "inputs": {
    "record": "{{setup.sys_id}}"
  },
  "wait": {
    "timeoutSec": 120
  },
  "assert": [
    {
      "table": "sys_journal_field",
      "locate": {
        "byQuery": "element=work_notes^element_id={{setup.sys_id}}"
      },
      "field": "value",
      "expect": {
        "value": "Demo subflow added this note."
      },
      "note": "sets work_notes to the expected text"
    }
  ],
  "cleanup": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      }
    },
    {
      "table": "sys_journal_field",
      "locate": {
        "byQuery": "element=work_notes^element_id={{setup.sys_id}}"
      }
    }
  ]
}